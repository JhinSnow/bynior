# -------------------------------------------------------------
# Supabase Database Connection
# -------------------------------------------------------------
# Connection Pooler URL (Transaction Mode Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (Session Mode Port 5432 - สำหรับ Prisma Migrations / db push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# Security Secrets
# -------------------------------------------------------------
JWT_SECRET="bynior-super-secure-jwt-secret-key-32charslong!"
QR_HMAC_SECRET="bynior-secret-qr-hmac-key-very-long-and-random-32chars!"
ADMIN_PASSWORD="ByeniorSamoSci"

# -------------------------------------------------------------
# Cloudflare Tunnel (สำหรับการ Deploy ผ่าน Docker + Cloudflare)
# -------------------------------------------------------------
# รับ Token ได้จาก Cloudflare Zero Trust Dashboard > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""

# -------------------------------------------------------------
# Google Sheets API Service Account (สำหรับ Sync ข้อมูลรอบแรก)
# -------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
